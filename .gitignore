.venv/
__pycache__/
*.pyc
*.db
.quantforge/
data/
logs/
.pytest_cache/

# Build artifacts. Regenerated by `pip install -e .`, and they contain absolute
# paths from the machine that built them, so committing them produces a
# spurious diff on every other checkout.
*.egg-info/
build/
dist/

# Local configuration and credentials. config.yaml is committed as the
# documented default, but a real deployment's overrides and any secret
# material must never be.
.env
*.local.yaml

node_modules/
dist/
.env
.env.local
